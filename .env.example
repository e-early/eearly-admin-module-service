# Database
DB_URL=jdbc:postgresql://localhost:5432/eearly-admin_db
DB_SCHEMA=eearly_admin
DB_AUDIT_SCHEMA=eearly_admin_audit
DB_SERVICE_USER=eearly-admin
DB_SERVICE_PASS=eearly-admin
DB_FLYWAY_USER=eearly-admin
DB_FLYWAY_PASS=eearly-admin
DB_FLYWAY_MIGRATION_PATHS=classpath:db/migration,classpath:/db/test-data

# Auth
JWK_SET_URI=http://localhost:8080/realms/eearly/protocol/openid-connect/certs

# Mobile OSS integration (measurements via gRPC + user onboarding)
# Ports match eearly-mobile-module-service-opensource local defaults
MOBILE_SERVICE_BASE_URL=http://localhost:8081/api/v1
MOBILE_KEYCLOAK_BASE_URL=http://localhost:9091
MOBILE_KEYCLOAK_REALM=eearly-mobile
# From mobile realm-config → client admin-service
MOBILE_KEYCLOAK_ADMIN_CLIENT_SECRET=JTAk6BzrwcIumfUVh6TssRUbU7wTTZl5
GRPC_ADDRESS=static://localhost:8082

# Hosted apnea model (POST {APNEA_SERVICE_ENDPOINT}/predict)
# Acceptance example: http://10.10.10.78:3001
APNEA_SERVICE_ENDPOINT=http://localhost:3001

# Algorithm HTTP client auth (required if model returns 401)
ALGORITHM_BASIC_AUTH_USERNAME=eearly-bentoml_auth_user
ALGORITHM_BASIC_AUTH_PASSWORD=

SERVICE_DOMAIN_URL=http://localhost:9000
