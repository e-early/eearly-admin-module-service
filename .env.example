# Database
DB_URL=jdbc:postgresql://localhost:5432/eearly-admin_db
DB_SCHEMA=eearly_admin
DB_AUDIT_SCHEMA=eearly_admin_audit
DB_SERVICE_USER=eearly-admin
DB_SERVICE_PASS=eearly-admin
DB_FLYWAY_USER=eearly-admin
DB_FLYWAY_PASS=eearly-admin
DB_FLYWAY_MIGRATION_PATHS=classpath:db/migration,classpath:/db/test-data

# Auth
JWK_SET_URI=http://localhost:8080/realms/eearly/protocol/openid-connect/certs

# Mobile OSS integration (measurements via gRPC + user onboarding)
# Ports match eearly-mobile-module-service-opensource local defaults
MOBILE_SERVICE_BASE_URL=http://localhost:8081/api/v1
MOBILE_KEYCLOAK_BASE_URL=http://localhost:9091
MOBILE_KEYCLOAK_REALM=eearly-mobile
# From mobile realm-config → client admin-service
MOBILE_KEYCLOAK_ADMIN_CLIENT_SECRET=JTAk6BzrwcIumfUVh6TssRUbU7wTTZl5
GRPC_ADDRESS=static://localhost:8082

# Hosted apnea model (POST {APNEA_SERVICE_ENDPOINT}/predict)
# Acceptance example: http://<apnea-service-host>:3001
APNEA_SERVICE_ENDPOINT=http://localhost:3001

# Algorithm HTTP client auth (required if model returns 401)
ALGORITHM_BASIC_AUTH_USERNAME=eearly-bentoml_auth_user
ALGORITHM_BASIC_AUTH_PASSWORD=

SERVICE_DOMAIN_URL=http://localhost:9000

# Webhook-style algorithm providers (optional, see README, section "Webhook-style algorithm providers")
# Secret that signs the single-use callback token; empty = off. Generate one with: openssl rand -base64 48
#ALGORITHM_CALLBACK_TOKEN_SECRET=
# Validity of a callback token, an ISO-8601 duration
#ALGORITHM_CALLBACK_TOKEN_TTL=PT15M
# Fails executions that stay SUBMITTED/RUNNING; the timeout must exceed BENTOML_TIMEOUT (seconds, default 3600)
#ALGORITHM_STUCK_SWEEP_ENABLED=true
#ALGORITHM_STUCK_SWEEP_POLL_INTERVAL_MS=300000
#ALGORITHM_STUCK_SWEEP_TIMEOUT_MINUTES=90
# Key (Base64, 32 bytes) that encrypts per-algorithm passwords; empty = they cannot be set.
# Generate one with: openssl rand -base64 32
#ALGORITHM_CREDENTIALS_ENCRYPTION_KEY=

# E-mail (see README, section "E-mail")
# SMTP server. Without it no e-mail is delivered, but nothing else fails. With the development profile
# the default is a local catch-all server (MailHog / Mailpit) on localhost:1025.
MAIL_HOST=localhost
MAIL_PORT=25
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_SMTP_AUTH=false
MAIL_SMTP_STARTTLS=false
MAIL_SMTP_SSL=false
# Optional timeouts in milliseconds
#MAIL_CONNECTION_TIMEOUT_MS=10000
#MAIL_TIMEOUT_MS=60000
# Sender address and application name shown in the messages
EMAIL_FROM=noreply@example.org
EMAIL_APP_NAME=eEarly
# Comma-separated recipient domains that may receive e-mail (* = all)
EMAIL_ALLOWED_RECIPIENT_DOMAINS=*
# Optional link to the mobile application, shown in the QR code message
EMAIL_APP_DOWNLOAD_URL=
# Branding: folder of the templates, the QR code template file name and the logo
# (classpath: or file: locations; an empty logo sends the messages without one)
#EMAIL_TEMPLATE_FOLDER=file:/etc/eearly/email-templates/
#EMAIL_TEMPLATE=qr-code-email.html
#EMAIL_LOGO=file:/etc/eearly/email-templates/logo.png
# App-link page encoded in QR codes; empty encodes the onboarding link issued by the mobile service (see README,
# section "QR code onboarding")
#QR_CODE_LINK_BASE_URL=
# Validity of a QR code, an ISO-8601 duration; keep it equal to the onboarding link validity of the mobile service
#ONBOARDING_CODE_VALIDITY=P30D
# Accept a plain http onboarding link (local development only; the development profile enables it)
#QR_CODE_ALLOW_HTTP_ONBOARDING_URL=false
